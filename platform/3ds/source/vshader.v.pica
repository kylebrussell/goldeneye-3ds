; Minimal PICA200 shader for the first native renderer milestone.

.fvec projection[4]

.constf constants(0.0, 1.0, 0.0, 0.0)
.alias ones constants.yyyy

.out outpos position
.out outtex texcoord0
.out outclr color

.alias inpos v0
.alias intex v1
.alias inclr v2

.proc main
    mov r0.xyz, inpos
    mov r0.w, ones

    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0

    ; The two-component attribute loader supplies the native default z/w
    ; components.  Copy the complete register, matching citro3d's textured
    ; vertex contract so PICA interpolates the authored u/v values.
    mov outtex, intex
    mov outclr, inclr
    end
.end
